<Window x:Class="PassManaAlpha.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:PassManaAlpha" xmlns:viewModel="clr-namespace:PassManaAlpha.MVVM.ViewModel"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="600"
        Width="930"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">

    <Window.DataContext>
        <viewModel:MainViewModel/>
    </Window.DataContext>

    <Grid Background="#FF150E20">
        <MediaElement x:Name="GlobalBgVideo" Source="pack://siteoforigin:,,,/assets/kazusa_L2D.mp4" LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="Collapsed">
            <MediaElement.Style>
                <Style TargetType="MediaElement">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <BlurEffect Radius="8"/>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentViewTypeName}" Value="SettingsViewModel">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="24"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </MediaElement.Style>
        </MediaElement>

        <Border IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FF403850"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentViewTypeName}" Value="AboutViewModel">
                            <Setter Property="Background" Value="#AA403850"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentViewTypeName}" Value="SettingsViewModel">
                            <Setter Property="Background" Value="#E21A1526"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Grid ShowGridLines="False" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="123"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="PassMana" FontSize="16" Foreground="#FFF2EBFF" Margin="3,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="0" FontWeight="Bold" FontFamily="Segoe UI Semibold"/>

            <Border BorderThickness="3" BorderBrush="#FF685976" Margin="0,10,0,0" Grid.Column="0" Grid.Row="1" Background="#FF534661" CornerRadius="4">
                <Grid>
                    <StackPanel Margin="0,10,0,0">
                        <Button Content="Home" Width="104" Style="{StaticResource LocalTypical}" Height="40" Margin="0,10,0,0" Background="#FF563865" Foreground="White" BorderBrush="#FF2D2F38" IsDefault="True" Command="{Binding HomeViewCommand}"/>
                        <Button Content="Passwords" Width="104" Style="{StaticResource LocalTypical}" Height="40" Margin="0,10,0,0" Background="#FF563865" Foreground="White" BorderBrush="#FF2D2F38" Command="{Binding PasswordViewCommand}"/>
                        <Button Content="Settings" Width="104" Style="{StaticResource LocalTypical}" Height="40" Margin="0,10,0,0" Background="#FF563865" Foreground="White" BorderBrush="#FF2D2F38" Command="{Binding SettingsViewCommand}"/>
                        <Button Content="About" Width="104" Style="{StaticResource LocalTypical}" Height="40" Margin="0,10,0,0" Background="#FF563865" Foreground="White" BorderBrush="#FF2D2F38" Command="{Binding AboutViewCommand}" FontSize="15"/>
                        <Label Content="v1.0.1" Foreground="#FFA0A0A0" RenderTransformOrigin="0.506,-0.004"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Grid.Column="1" Margin="3" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>