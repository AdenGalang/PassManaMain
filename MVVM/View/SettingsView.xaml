<UserControl x:Class="PassManaAlpha.MVVM.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#FF403850">

    <Grid>
        <Image Source="/assets/nekoma.png" IsHitTestVisible="False" Panel.ZIndex="-1"
               Margin="523,0,0,2" Height="295" VerticalAlignment="Bottom" Stretch="UniformToFill"/>

        <Border CornerRadius="12" Margin="0,441,0,0" Padding="20" VerticalAlignment="Bottom"
                Background="#FF8B78B0" Height="9"/>

        <StackPanel Margin="188,94,188,93">

            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <Border Background="#643566" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Vault Keys" Foreground="#F0C0F0" FontSize="13"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,16">
                        Each vault now has its own master key.
                        Select a vault on the Home screen and enter its key in the inline key field.
                        Keys are held in memory only and are never saved to disk.
                    </TextBlock>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Folder" Style="{StaticResource LocalTypical}"
                                Width="80" Height="32" Margin="0,0,8,0"
                                ToolTip="Open application folder"
                                Click="OpenExeFolder_Click" Background="#FF6F506F"/>
                        <Button Content="Backup" Style="{StaticResource LocalTypical}"
                                Width="80" Height="32"
                                ToolTip="Open backups folder"
                                Click="OpenBackupFolder_Click" Background="#FF6F506F"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
