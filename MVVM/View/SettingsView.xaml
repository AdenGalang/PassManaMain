<UserControl x:Class="PassManaAlpha.MVVM.View.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" ><!-- "#FF403850" -->
    
    <UserControl.Resources>
        <Storyboard x:Key="FadeNotificationStoryboard">
            <DoubleAnimation Storyboard.TargetName="NotificationText" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="NotificationText" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.5" BeginTime="0:0:1.8"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Image Source="/assets/nekoma.png" IsHitTestVisible="False" Panel.ZIndex="-1" Margin="523,0,0,2" Height="295" VerticalAlignment="Bottom" Stretch="UniformToFill"/>
        <Border CornerRadius="12" Margin="0,441,0,0" Padding="20" VerticalAlignment="Bottom" Background="#FF8B78B0" Height="9"/>
        <Border x:Name="NotificationContainer" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#66282235" BorderBrush="#60B49BD2" BorderThickness="2" CornerRadius="3" Padding="15,10,20,10" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="10" Margin="599,198,0,0">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="MaskStop1" Color="Black" Offset="0"/>
                    <GradientStop x:Name="MaskStop2" Color="Transparent" Offset="0"/>
                </LinearGradientBrush>
            </Border.OpacityMask>

            <TextBlock x:Name="NotificationText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" FontFamily="Noto Sans" FontWeight="ExtraLight"> </TextBlock>
        </Border>

        <StackPanel Margin="188,60,188,60">

            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <Border Background="#643566" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Vault Management" Foreground="#F0C0F0" FontSize="13"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,16"> Each vault now has its own master key. Select a vault on the Home screen and enter its key in the inline key field. Keys are held in memory only and are never saved to disk. </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Folder" Style="{StaticResource LocalTypical}" Width="80" Height="32" Margin="0,0,8,0" ToolTip="Open application folder" Click="OpenExeFolder_Click" Background="#FF6F506F"/>
                        <Button Content="BC-Folder" Style="{StaticResource LocalTypical}" Width="80" Height="32" Margin="0,0,8,0" ToolTip="Open backups folder" Click="OpenBackupFolder_Click" Background="#FF6F506F"/>
                        <Button Content="Backup" Style="{StaticResource LocalTypical}" Width="80" Height="32" ToolTip="Trigger manual vault file backup" Command="{Binding ManualBackupCommand}" Background="#FF6F506F"/>
                    </StackPanel>

                    <Border BorderBrush="#4a3460" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>
                    
                    <TextBlock Text="Warning!" Foreground="#FFA0A0" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Move active loaded vault to Windows Recycle Bin. This can be undone from your desktop workspace." VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="10" Margin="0,0,12,0"/>

                        <Button Grid.Column="1" Content="Delete" Style="{StaticResource LocalTypical}" Width="80" Height="32" ToolTip="Send active database file to Recycle Bin" Command="{Binding DeleteActiveVaultCommand}" Background="#FF993D3D"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>