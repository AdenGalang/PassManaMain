<UserControl x:Class="PassManaAlpha.MVVM.View.UserHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PassManaAlpha.MVVM.View"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Vault card style -->
        <Style x:Key="VaultCard" TargetType="Border">
            <Setter Property="Background" Value="#1E1B2E"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Background" Value="#563865"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7a4a8a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3C173C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2040"/>
            <Setter Property="Foreground" Value="#E8D5E8"/>
            <Setter Property="BorderBrush" Value="#4a3460"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="kazusa"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0"
                BeginTime="0:0:1"
                Duration="0:0:2"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- Decorative background image (the maid easter egg) -->
        <Image x:Name="kazusa" Source="/assets/Home.jpg" Width="800"
               Stretch="UniformToFill" HorizontalAlignment="Center"
               VerticalAlignment="Center" Opacity="0"/>

        <!-- Two-column layout: left = clock/stats  |  right = vault manager -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════ LEFT PANEL ═══════════════ -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="0,0,16,0">

                <StackPanel>
                    <TextBlock Foreground="#FFC5B5C5" FontSize="14" Height="23">
                        <Run Text="Vault: "/>
                        <Run Text="{Binding VaultCount, Mode=OneWay}" Foreground="White"/>
                        <Run Text=" entries"/>
                    </TextBlock>
                    <TextBlock Foreground="#FFC5B5C5" FontSize="14" Margin="0,4,0,0" Height="23">
                        <Run Text="Last accessed: "/>
                        <Run Text="{Binding LastAccessed, Mode=OneWay}" Foreground="White"/>
                    </TextBlock>
                </StackPanel>

                <Border Background="#80000000" CornerRadius="10" Padding="20" Margin="0,20,0,0" Width="280">
                    <StackPanel>
                        <TextBlock FontFamily="Noto Sans JP Medium" TextAlignment="Center"
                                   Text="Time" Foreground="#FFAEAEAE" FontSize="20"
                                   Background="#FF856D8A"/>
                        <TextBlock Text="{Binding CurrentDate, Mode=OneWay}" Foreground="White"
                                   FontSize="18" FontFamily="Noto Sans JP Medium"
                                   TextAlignment="Center" Height="37"/>
                        <TextBlock Text="{Binding CurrentTime, Mode=OneWay}" Foreground="White"
                                   FontSize="18" FontFamily="Noto Sans JP Medium"
                                   TextAlignment="Center" Height="42"/>
                        <TextBlock Text="Your random project name&gt;" FontSize="16"
                                   FontWeight="Light" HorizontalAlignment="Center" Foreground="White"/>
                        <Button Content="call the maid&gt;?" Click="Button_Click"
                                Width="150" Height="40" Margin="0,20,0,0"
                                HorizontalAlignment="Center" Style="{StaticResource LocalTypical}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══════════════ RIGHT PANEL — Vault Manager ═══════════════ -->
            <Border Grid.Column="1" Background="#22152E" CornerRadius="12"
                    Margin="0,12,12,12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- header + buttons -->
                        <RowDefinition Height="*"/>     <!-- vault list -->
                        <RowDefinition Height="Auto"/>  <!-- inline key row -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Vaults" Foreground="White" FontSize="15"
                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="＋ New" Style="{StaticResource SmallBtn}"
                                    Command="{Binding VaultManager.NewVaultCommand}"
                                    Margin="0,0,6,0" Width="66"/>
                            <Button Content="📂 Open" Style="{StaticResource SmallBtn}"
                                    Command="{Binding VaultManager.OpenVaultCommand}"
                                    Width="72"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Vault list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VaultManager.Vaults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MouseLeftButtonDown="VaultCard_MouseLeftButtonDown"
                                            Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource VaultCard}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#3a2050"/>
                                                        <Setter Property="BorderBrush" Value="#c084fc"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White" FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding FilePath}"
                                                           Foreground="#5a4a6a" FontSize="9"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Foreground="#a38ca3" FontSize="10"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Remove button -->
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Style="{StaticResource SmallBtn}"
                                                    Background="Transparent"
                                                    Foreground="#6a4a6a"
                                                    Width="22" Height="22" Padding="0"
                                                    FontSize="10"
                                                    ToolTip="Remove from list (file not deleted)"
                                                    Command="{Binding DataContext.VaultManager.RemoveVaultCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Inline key row — visible only when a vault is selected -->
                    <Border Grid.Row="2"
                            Visibility="{Binding VaultManager.HasSelection,
                                         Converter={StaticResource BoolToVis}}"
                            Background="#2D1F3D" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Foreground="#a38ca3" FontSize="10" Margin="0,0,0,4">
                                <Run Text="Key for: "/>
                                <Run Text="{Binding VaultManager.SelectedVault.Name, Mode=OneWay}"
                                     Foreground="White" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- PasswordBox key input — wired in code-behind -->
                                <PasswordBox x:Name="VaultKeyBox"
                                             Grid.Column="0"
                                             Style="{StaticResource KeyBox}"
                                             PasswordChanged="VaultKeyBox_PasswordChanged"
                                             ToolTip="Enter master key for this vault"/>
                                <Button Grid.Column="1"
                                        Content="✓"
                                        Style="{StaticResource SmallBtn}"
                                        Width="28" Margin="6,0,0,0"
                                        ToolTip="Confirm key"
                                        Click="ConfirmKey_Click"/>
                            </Grid>
                            <TextBlock Text="{Binding VaultManager.SelectedVault.StatusLabel}"
                                       Foreground="#a38ca3" FontSize="10" Margin="0,6,0,0"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
